        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बार-बार छोटे खर्चों की समीक्षा ज़रूरी है क्योंकि उन्हें दुर्लभ बड़े खर्चों की तुलना में आसान बदला जा सकता है।"
