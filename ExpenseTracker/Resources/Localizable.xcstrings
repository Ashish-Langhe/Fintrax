          }
        }
      }
    },
    "analytics.ai.detail.peakDay": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein ausgabenstärkster Tag war %@. Prüfe, was an diesem Tag passiert ist, und ob es geplant oder vermeidbar war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your highest spending day was %@. Review what happened that day and decide if it was planned or avoidable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu día de mayor gasto fue %@. Revisa qué ocurrió ese día y decide si fue planificado o evitable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सबसे अधिक खर्च वाला दिन %@ था। उस दिन क्या हुआ देखें और तय करें कि वह योजनाबद्ध था या टाला जा सकता था।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा सर्वाधिक खर्चाचा दिवस %@ होता. त्या दिवशी काय झाले ते पाहा आणि तो नियोजित होता की टाळता आला असता ते ठरवा."
          }
        }
      }
    },
    "analytics.ai.detail.reduceCategory": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche %@ um 10%% zu reduzieren. Das beginnt mit einem täglichen Zielabzug von etwa %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try reducing %@ by 10%%. That starts with a daily target cut near %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta reducir %@ en un 10%%. Eso empieza con un recorte diario cercano a %@."
