    "Notice what was different on that day. Repeating that routine is usually easier than only cutting big purchases.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beachte, was an diesem Tag anders war. Diese Routine zu wiederholen ist meist einfacher als nur große Käufe zu kürzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice what was different on that day. Repeating that routine is usually easier than only cutting big purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa qué fue diferente ese día. Repetir esa rutina suele ser más fácil que solo recortar grandes compras."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें उस दिन क्या अलग था। उस रूटीन को दोहराना अक्सर सिर्फ बड़े खर्च काटने से आसान होता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या दिवशी काय वेगळे होते ते पाहा. ती दिनचर्या पुन्हा करणे मोठे खर्च कमी करण्यापेक्षा सोपे असते."
          }
        }
      }
    },
