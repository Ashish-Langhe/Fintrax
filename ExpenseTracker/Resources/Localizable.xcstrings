        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Ausgaben für dieses Datum vor der Monatsprüfung; ein ungewöhnlich starker Tag erklärt oft den ganzen Trend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open expenses for this date before month-end review; one unusually heavy day often explains the whole trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los gastos de esta fecha antes de la revisión de fin de mes; un día inusualmente alto suele explicar toda la tendencia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीने के अंत की समीक्षा से पहले इस तारीख के खर्च खोलें; एक असामान्य भारी दिन अक्सर पूरी प्रवृत्ति समझा देता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "महिनाअखेरच्या आढाव्यापूर्वी या तारखेचे खर्च उघडा; एक असामान्य जड दिवस संपूर्ण ट्रेंड स्पष्ट करतो."
          }
        }
      }
    },
