        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de tu gasto del período seleccionado está en %@. Esta es la primera categoría para optimizar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी हुई अवधि के खर्च का %@ %@ में है। सुधार के लिए यह पहली श्रेणी है।"
